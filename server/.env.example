DATABASE_URL=postgresql://SERVER_ROLE:PASSWORD@SUPABASE_HOST:5432/postgres?sslmode=verify-full
BETTER_AUTH_URL=https://YOUR_APP.fly.dev
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET
SMS_ENDPOINT=https://YOUR_PROVIDER/transactional-sms
SMS_API_KEY=REPLACE
SMS_TEMPLATE_ID=REPLACE_WITH_APPROVED_INDIA_OTP_TEMPLATE
PORT=8080

# Choose webhook for your SMS gateway contract, or twilio for the built-in adapter.
SMS_PROVIDER=webhook
TWILIO_ACCOUNT_SID=AC_REPLACE
TWILIO_AUTH_TOKEN=REPLACE
TWILIO_MESSAGING_SERVICE_SID=MG_REPLACE
# Match your registered India transactional OTP template exactly.
TWILIO_OTP_BODY=Your MoneyTrack verification code is {code}.
